{
  "experiment": "classification_strategy_comparison",
  "feature_set": "demographic_multiday",
  "features": [
    "age",
    "sex_female",
    "bmi",
    "sodium_mg_mean",
    "potassium_mg_mean",
    "energy_kcal_mean",
    "sat_fat_g_mean",
    "na_k_ratio_mean"
  ],
  "target_categories": [
    "Normal",
    "Elevated",
    "Stage 1",
    "Stage 2"
  ],
  "seed": 42,
  "n_folds": 5,
  "training_rows": 5978,
  "held_out_test_evaluated": false,
  "primary_metric": "macro_f1_mean",
  "strategies": [
    "balanced_logistic_regression",
    "cumulative_ordinal_logistic",
    "balanced_random_forest"
  ],
  "limitations": [
    "This is a diagnostic comparison, not a clinical validation.",
    "The cumulative ordinal baseline is a simple threshold-reduction approach, not a proportional-odds model.",
    "The held-out test partition is not evaluated or used for selection by this script."
  ]
